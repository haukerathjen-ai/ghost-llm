```env
# OpenAI API Key
# Used for Whisper (speech-to-text transcription)
# Get your API key from: https://platform.openai.com/api-keys
# You need to create an OpenAI account and add billing information
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key
# Used for Claude 3.5 Sonnet (AI text generation and analysis)
# Get your API key from: https://console.anthropic.com/settings/keys
# You need to create an Anthropic account and add billing information
ANTHROPIC_API_KEY=your_anthropic_api_key_here
```